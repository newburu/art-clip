<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Art Clip" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Art Clip">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <!-- <link rel="icon" href="/icon.svg" type="image/svg+xml"> -->
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Google Analytics %>
    <% if ENV["GOOGLE_ANALYTICS_ID"].present? %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ENV["GOOGLE_ANALYTICS_ID"] %>"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '<%= ENV["GOOGLE_ANALYTICS_ID"] %>');
      </script>
    <% end %>

    <%# Google AdSense %>
    <% if ENV["GOOGLE_ADSENSE_ID"].present? %>
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= ENV["GOOGLE_ADSENSE_ID"] %>" crossorigin="anonymous"></script>
    <% end %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <header class="bg-white shadow">
      <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8 flex justify-between items-center">
        <%= link_to root_path, class: "flex items-center gap-2 text-3xl font-bold tracking-tight text-gray-900 no-underline" do %>
          <%= image_tag "/icon.png", class: "h-10 w-10 object-contain" %>
          <span><%= t("views.common.app_name") %></span>
        <% end %>
        <% if logged_in? %>
          <div class="flex-1 max-w-lg mx-8">
            <%= form_with url: events_path, method: :get, local: true, class: "relative" do |f| %>
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
                </svg>
              </div>
              <%= f.text_field :q, value: params[:q], placeholder: t("views.common.search"), class: "block w-full rounded-md border-0 bg-gray-100 py-1.5 pl-10 pr-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:bg-white focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            <% end %>
          </div>
        <% end %>

        <div class="flex items-center gap-4">
          <% if logged_in? %>
            <div class="flex items-center gap-2">
              <% if current_user.image %>
                <%= image_tag current_user.image, class: "h-8 w-8 rounded-full" %>
              <% end %>
              <span class="hidden sm:inline font-medium text-gray-700"><%= current_user.name %></span>
            </div>
            <%= button_to t("views.common.sign_out"), signout_path, method: :delete, class: "text-sm text-gray-500 hover:text-gray-700 font-medium" %>
          <% else %>
            <%= button_to t("views.common.sign_in_google"), "/auth/google_oauth2", method: :post, data: { turbo: false }, class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
          <% end %>
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
      <%= yield %>
    </main>
  </body>
</html>
