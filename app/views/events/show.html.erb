<div class="w-full max-w-4xl mx-auto bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
  <% if @event.image_url.present? %>
    <div class="w-full h-64 md:h-96 relative">
      <%= image_tag @event.image_url, class: "w-full h-full object-cover" %>
      <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-6 pt-20">
        <h1 class="text-3xl font-bold text-white shadow-sm"><%= @event.title %></h1>
      </div>
    </div>
  <% else %>
     <div class="p-6 pb-0">
        <h1 class="text-3xl font-bold text-gray-900"><%= @event.title %></h1>
     </div>
  <% end %>

  <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="md:col-span-2 space-y-6">
       <!-- Details -->
       <div>
         <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2 flex items-center gap-1">
           <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
           <%= t("views.events.show.description") %>
         </h2>
         <p class="text-gray-700 whitespace-pre-wrap leading-relaxed"><%= @event.description.presence || t("views.events.show.no_description", default: "") %></p>
       </div>

       <% if @event.memo.present? %>
         <div class="bg-yellow-50 p-4 rounded-lg border border-yellow-100">
           <h2 class="text-sm font-semibold text-yellow-800 mb-2 flex items-center gap-1">
             <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
             <%= t("views.events.show.memo") %>
           </h2>
           <p class="text-gray-700 whitespace-pre-wrap"><%= @event.memo %></p>
         </div>
       <% end %>

       <div>
         <a href="<%= @event.url %>" target="_blank" rel="noopener noreferrer" class="text-indigo-600 hover:underline flex items-center gap-1">
           <%= t("views.events.show.visit_website") %>
           <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
         </a>
       </div>
    </div>

    <div class="space-y-6">
      <!-- Sidebar/Actions -->
      <div class="bg-gray-50 p-4 rounded-lg border border-gray-100 space-y-4">
        <div>
          <span class="block text-xs font-semibold text-gray-500 uppercase mb-1 flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <%= t("views.events.show.status") %>
          </span>
          <%= status_badge(@event.status) %>
        </div>

        <% if @event.scheduled_date %>
          <div>
            <span class="block text-xs font-semibold text-gray-500 uppercase mb-1 flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-gray-500">
                <path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401z" clip-rule="evenodd" />
              </svg>
              <%= t("activerecord.attributes.event.scheduled_date") %>
            </span>
            <div class="text-gray-900 font-medium ml-5">
              <%= l(@event.scheduled_date, format: :long) %>
            </div>
          </div>
        <% end %>

        <div>
          <span class="block text-xs font-semibold text-gray-500 uppercase mb-1 flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            <%= t("views.events.show.date") %>
          </span>
          <div class="text-gray-900 font-medium ml-5">
             <% if @event.start_date %>
               <%= l(@event.start_date, format: :long) %>
               <% if @event.end_date %>
                 <br><span class="text-gray-500 text-sm">～</span><br>
                 <%= l(@event.end_date, format: :long) %>
               <% end %>
             <% else %>
               <%= t("views.events.show.tbd") %>
             <% end %>
          </div>
        </div>

        <% if @event.location.present? %>
          <div>
            <span class="block text-xs font-semibold text-gray-500 uppercase mb-1 flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <%= t("views.events.show.location") %>
            </span>
            <div class="text-gray-900 ml-5"><%= @event.location %></div>
          </div>
        <% end %>

        <div class="pt-4 border-t border-gray-200 flex flex-col gap-3">
          <% if @event.scheduled_date || (@event.start_date && @event.end_date) %>
            <a href="<%= google_calendar_url(@event) %>" target="_blank" class="flex items-center justify-center gap-2 w-full rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
              <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <%= t("views.events.show.add_to_calendar") %>
            </a>
          <% end %>
          
          <%= link_to edit_event_path(@event), class: "flex items-center justify-center gap-2 w-full rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            <%= t("views.common.edit") %>
          <% end %>

          <%= button_to t("views.common.delete"), @event, method: :delete, class: "w-full text-center text-red-600 hover:text-red-800 text-sm", form: { data: { turbo_confirm: t("views.common.confirm") } } %>
        </div>
      </div>
    </div>
  </div>

  <div class="p-6 border-t border-gray-200">
    <%= link_to t("views.common.back"), events_path, class: "text-indigo-600 hover:underline" %>
  </div>
</div>
