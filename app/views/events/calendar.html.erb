<div class="px-4 py-8 max-w-7xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900"><%= t('views.events.calendar.title') %></h1>
    <div class="flex gap-4">
      <div class="flex items-center gap-2 text-sm">
        <span class="w-3 h-3 bg-blue-100 border border-blue-300 block"></span>
        <span class="text-gray-600"><%= t('views.events.calendar.period') %></span>
      </div>
      <div class="flex items-center gap-2 text-sm">
        <span class="w-3 h-3 bg-yellow-100 border border-yellow-400 block"></span>
        <span class="text-gray-600"><%= t('views.events.calendar.scheduled') %></span>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow border border-gray-200 p-4">
    <%= month_calendar(events: @events, attribute: :start_date, end_attribute: :end_date) do |date, events| %>
      <div class="min-h-[100px] group">
        <!-- Date Loop Logic -->
        <% events.each do |event| %>
             <% 
               is_scheduled = event.scheduled_date&.to_date == date
               is_start = date == event.start_date.to_date || date.wday == 0 # Start of event or Start of row (Sunday)
               is_end = date == event.end_date.to_date || date.wday == 6   # End of event or End of row (Saturday)

               base_classes = "h-5 mb-1 text-xs truncate w-full cursor-pointer transition hover:opacity-100 hover:shadow-sm"
               
               style_classes = if is_scheduled
                 "bg-yellow-100 font-medium text-gray-900 border border-yellow-400 rounded mx-1"
               else
                 # Duration Bar Logic
                 classes = "bg-blue-100 text-blue-800 border-t border-b border-blue-200"
                 classes += " rounded-l border-l ml-1" if is_start
                 classes += " rounded-r border-r mr-1" if is_end
                 classes += " border-l-0 rounded-l-none -ml-px" unless is_start
                 classes += " border-r-0 rounded-r-none -mr-px" unless is_end
                 classes
               end
             %>
             
             <div class="<%= base_classes %> <%= style_classes %>" title="<%= event.title %>">
                <%= link_to event, class: "block w-full h-full px-1 flex items-center" do %>
                   <% if is_scheduled %>
                     <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3 mr-1 text-yellow-600 flex-shrink-0">
                       <path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401z" clip-rule="evenodd" />
                     </svg>
                  <% elsif is_start %>
                     <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3 mr-1 text-blue-500 flex-shrink-0">
                       <path fill-rule="evenodd" d="M5.75 2a.75.75 0 01.75.75V4h7V2.75a.75.75 0 011.5 0V4h.25A2.75 2.75 0 0118 6.75v8.5A2.75 2.75 0 0115.25 18H4.75A2.75 2.75 0 012 15.25v-8.5A2.75 2.75 0 014.75 4h.25V2.75A.75.75 0 015.75 2zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75z" clip-rule="evenodd" />
                     </svg>
                  <% end %>
                  <span class="truncate">
                    <%= event.title if is_start || date.wday == 0 || is_scheduled %>
                  </span>
                <% end %>
             </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
