<div id="<%= dom_id event %>" class="break-inside-avoid relative group rounded-lg border border-gray-200 bg-white shadow-sm hover:shadow-md transition overflow-hidden">
  <%= link_to event, class: "block no-underline" do %>
    <% if event.image_url.present? %>
       <%= image_tag event.image_url, class: "w-full h-auto object-cover", loading: "lazy", alt: event.title %>
    <% else %>
       <div class="w-full h-48 bg-gray-100 flex items-center justify-center text-gray-400">
         <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
         </svg>
       </div>
    <% end %>
    
    <div class="p-4">
       <h3 class="font-bold text-gray-900 mb-2 leading-tight group-hover:text-indigo-600"><%= event.title %></h3>
       
       <div class="flex flex-wrap items-center gap-2 mb-3">
         <%= status_badge(event.status) %>
       </div>

       <% if event.start_date || event.end_date %>
         <div class="text-xs text-gray-500 flex items-center gap-1">
           <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
           </svg>
           <span>
             <% if event.start_date %>
               <%= l(event.start_date, format: :short) %>
             <% end %>
             <% if event.end_date %>
               ~ <%= l(event.end_date, format: :short) %>
             <% end %>
           </span>
         </div>
       <% end %>

       <% if event.location.present? %>
         <div class="mt-2 text-xs text-gray-500 flex items-center gap-1 truncate">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <%= event.location %>
         </div>
       <% end %>
    </div>
  <% end %>
</div>
