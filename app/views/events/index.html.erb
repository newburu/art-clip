<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <% if logged_in? %>
    <div class="flex justify-between items-center mb-6">
      <h1 class="font-bold text-3xl text-gray-800">Events</h1>
      <%= link_to "New Event", new_event_path, class: "rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
    </div>

    <% if @events.any? %>
      <div class="columns-1 sm:columns-2 lg:columns-4 gap-4 space-y-4">
        <%= render @events %>
      </div>
    <% else %>
      <div class="text-center py-20 bg-white rounded-lg border border-gray-200 shadow-sm">
        <h2 class="text-xl font-semibold text-gray-900 mb-2">No events yet</h2>
        <p class="text-gray-500 mb-6">Add your first museum or exhibition event to start tracking.</p>
        <%= link_to "Add Event", new_event_path, class: "rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-20">
      <h1 class="text-5xl font-bold tracking-tight text-gray-900 mb-6">Art Clip</h1>
      <p class="text-xl text-gray-600 mb-10 max-w-2xl mx-auto">
        Keep track of museums and exhibitions you want to visit.<br>
        Save URLs, manage status, and sync with your calendar.
      </p>
      <%= button_to "Sign in with Google", "/auth/google_oauth2", method: :post, data: { turbo: false }, class: "rounded-md bg-indigo-600 px-6 py-3 text-lg font-semibold text-white shadow-sm hover:bg-indigo-500 inline-block" %>
    </div>
  <% end %>
</div>
